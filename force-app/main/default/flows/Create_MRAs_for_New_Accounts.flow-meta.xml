    <formulas>
        <name>EndDateNext3Months</name>
        <dataType>Date</dataType>
        <expression>IF(
  MONTH({!$Flow.CurrentDate}) &gt;= 10,
  DATE(
    YEAR({!$Flow.CurrentDate}) + 1,
    MONTH({!$Flow.CurrentDate}) - 9,
    MIN(
      DAY({!$Flow.CurrentDate}),
      DAY(
        IF(
          MONTH({!$Flow.CurrentDate}) == 12,
          DATE(YEAR({!$Flow.CurrentDate}) + 2, 1, 1) - 1,
          DATE(YEAR({!$Flow.CurrentDate}) + 1, MONTH({!$Flow.CurrentDate}) - 8, 1) - 1
        )
      )
    )
  ),
  DATE(
    YEAR({!$Flow.CurrentDate}),
    MONTH({!$Flow.CurrentDate}) + 3,
    MIN(
      DAY({!$Flow.CurrentDate}),
      DAY(
        IF(
          MONTH({!$Flow.CurrentDate}) == 9,
          DATE(YEAR({!$Flow.CurrentDate}) + 1, 1, 1) - 1,
          DATE(YEAR({!$Flow.CurrentDate}), MONTH({!$Flow.CurrentDate}) + 4, 1) - 1
        )
      )
    )
  )
)</expression>
    </formulas>
